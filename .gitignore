# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is needed to set the app up
!.env.example

# OCR engine assets, copied out of node_modules by `pnpm ocr-assets` (which
# `pnpm dev` and `pnpm build` run first). ~13MB, and derived entirely from
# installed packages, so generating beats committing. The app icons under
# public/ are committed — these are not.
/public/tesseract
/public/pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# idea
.idea