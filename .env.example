# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI (use the
#           "Session pooler" / port 6543 string for serverless deploys).
# Neon:     Dashboard -> Connection Details -> Connection string.
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# The shared passcode you and your wife type once per device.
APP_PASSCODE="choose-something-you-both-remember"

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Optional. ISO 4217 code used to format prices, e.g. LKR, USD, EUR, GBP.
# Leave unset and amounts are shown as plain numbers with no symbol.
# NEXT_PUBLIC_CURRENCY="LKR"
